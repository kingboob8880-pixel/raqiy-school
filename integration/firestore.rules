rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Раздел "Архив" (content/_content_archive_index_md — bookKey() от
    // "/content/archive/index.md") разбирает материалы, исключённые из
    // сертифицируемой программы, с прямой критикой конкретных книг/методик.
    // Автор попросил "убери от всех кроме меня админа" (2026-07-21) — на
    // клиенте (pages/book.html) уже сделано, но реальная защита живёт
    // здесь: без этой правки любой ОПЛАТИВШИЙ курс ученик всё равно мог бы
    // прочитать полный текст прямым запросом к Firestore (SDK/консоль),
    // в обход JS-стены — то же рассуждение, что и у общего правила ниже
    // ("реальная защита пейвола вместо визуальной").
    function isArchiveDoc(docId) {
      return docId == '_content_archive_index_md';
    }

    // ⚠️ ЗАПРЕТ НА CREATE ЧУТЬ МЯГЧЕ, ЧЕМ НА UPDATE, И ЭТО НЕ НЕДОСМОТР.
    //
    // Форма регистрации создаёт профиль с `paid: false` — то есть ключ
    // 'paid' в новом документе ЕСТЬ. Первая версия правки (2026-07-27)
    // проверяла только наличие ключа, и регистрация на сайте перестала
    // работать у всех сразу: create отклонялся, аккаунт в Auth
    // создавался, а профиля не было. Поймано проверкой до выкладки.
    //
    // Поэтому на create смотрим не только на ключ, но и на значение:
    // 'paid' допустим ровно со значением false. `paid: true` при создании
    // по-прежнему невозможен — а именно он и давал бы бесплатный курс.
    // Остальные поля прав на create запрещены как ключи: их форма
    // регистрации не пишет вовсе, и появиться им неоткуда.
    function createIsClean(d) {
      return !d.keys().hasAny([
        'fullAccess', 'fullAccessAt',
        'certificateGranted', 'certificateGrantedAt',
        'rukyaProAccess', 'tgChatId', 'tgUsername', 'supervision'
      ])
        // Проверяем ЧЕРЕЗ keys().hasAny, а не через оператор `in`: hasAny
        // уже работает в этом же файле в двух местах, а значит в его
        // поведении сомневаться не приходится. Эмулятор Firestore в этой
        // среде поднять не удалось, и вводить сюда конструкцию, проверенную
        // только по документации, — не то, на чём стоит экономить: ценой
        // ошибки будет закрытая регистрация для всех.
        //
        // Второе условие вычисляется только когда ключ 'paid' есть, —
        // логическое ИЛИ вычисляется слева направо и останавливается.
        && (!d.keys().hasAny(['paid']) || d.paid == false);
    }

    // Поля прав при ОБНОВЛЕНИИ профиля — их ученик не трогает вовсе.
    function grantFields(keys) {
      return keys.hasAny([
        'paid', 'fullAccess', 'fullAccessAt',
        'certificateGranted', 'certificateGrantedAt',
        'rukyaProAccess',
        // Привязку Telegram ставит только бот (Admin SDK). Ученик выдаёт
        // себе лишь одноразовый КОД в своём кабинете; если бы он мог
        // записать tgChatId сам, он привязал бы свой Telegram к чужой
        // записи и получил чужой прогресс и чужую переписку.
        'tgChatId', 'tgUsername',
        // Допуск к практике. Ставится только по принятым разборам
        // случаев — сервером или админом. Разреши это ученику, и он
        // выдал бы себе допуск и сертификат сам.
        'supervision'
      ]);
    }

    match /admins/{uid} {
      // Список админов не создаётся через клиент — только вручную в консоли Firebase
      // (integration/README.md, шаг "Первый админ"), чтобы никто не мог сам себя
      // назначить админом через клиентский код.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /students/{uid} {
      // ⚠️ ФИЛЬТР ПОЛЕЙ НУЖЕН И НА CREATE, НЕ ТОЛЬКО НА UPDATE.
      //
      // Дыра, найденная аудитом 2026-07-27. Ниже стоит подробный запрет на
      // запись полей доступа при update — а create до сегодняшнего дня
      // проверял только «это твой uid». Обход занимал одну строку: ключ
      // веб-приложения Firebase публичный по устройству (он лежит в
      // integration/firebase-config.js и обязан быть открытым),
      // регистрация свободная. Значит любой мог завести себе учётную
      // запись и вместо формы сайта записать свой первый документ
      // напрямую из консоли браузера:
      //
      //   setDoc(doc(db,'students',myUid), {
      //     name:'x', email:'x@x.x',
      //     paid:true, fullAccess:true, certificateGranted:true,
      //     rukyaProAccess:true, supervision:{accepted:3}
      //   })
      //
      // isOwner проходил — и человек получал весь платный курс, доступ к
      // RUKYA Pro и сертификат школы рукьи, не заплатив и не отучившись.
      // Последнее особенно важно: сертификат говорит другим людям, что
      // этому человеку можно доверить своё здоровье.
      //
      // На create нужен именно keys().hasAny, а не diff(): сравнивать не с
      // чем, документа ещё нет.
      allow create: if isOwner(uid) && createIsClean(request.resource.data);
      allow read: if isOwner(uid) || isAdmin();
      // Ученик правит свой профиль/прогресс, но не поля выданных прав —
      // их переключает только админ вручную (project.md §18).
      //
      // Список расширен 2026-07-27 вместе с fullAccess. Раньше здесь стоял
      // один 'paid', а certificateGranted и rukyaProAccess ученик мог
      // выставить себе сам обычным обновлением своего же документа —
      // выдать себе сертификат и доступ к программе. Ставим все четыре
      // разом: поле, которое выдаёт права, ученику писать нечего.
      allow update: if (isOwner(uid)
                        && !grantFields(request.resource.data.diff(resource.data).affectedKeys()))
                    || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        // from обязан совпадать с реальной ролью пишущего — иначе ученик
        // может подделать сообщение "от админа" в своей же переписке.
        allow create: if (isOwner(uid) && request.resource.data.from == 'student')
                      || (isAdmin() && request.resource.data.from == 'admin');

        // Ученик отмечает прочитанными сообщения наставника. Раньше здесь
        // стояло только `isAdmin()`, поэтому markThreadRead(uid, 'student')
        // молча падал на правилах: поле read у сообщений админа навсегда
        // оставалось false, и наставник никогда не видел вторую галочку
        // (аудит 2026-07-25). Разрешаем узко — ученик может изменить ровно
        // одно поле `read` и только с false на true, у чужих (админских)
        // сообщений. Ни текст, ни автора, ни дату он так не подменит.
        function onlyMarksRead() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                 && request.resource.data.read == true
                 && resource.data.from == 'admin';
        }
        // Правка/удаление своего сообщения (запрос автора, 2026-07-25).
        // Ученик распоряжается только тем, что написал сам; текст можно
        // менять, авторство/дату создания — нет.
        function editsOwnText() {
          return resource.data.from == 'student'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
                 && request.resource.data.from == resource.data.from
                 && request.resource.data.createdAt == resource.data.createdAt;
        }
        allow update: if isAdmin()
                      || (isOwner(uid) && (onlyMarksRead() || editsOwnText()));
        allow delete: if isAdmin()
                      || (isOwner(uid) && resource.data.from == 'student');
      }

      // Разборы случаев для супервизии Модуля 11 (решение автора
      // 2026-07-27). Ученик пишет свой черновик и отправляет его на
      // проверку; заключение наставника и статус «принят» ставит только
      // админ — иначе выпускник допускал бы к практике сам себя.
      match /cases/{caseId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin()
                      || (isOwner(uid) && request.resource.data.status in ['draft', 'submitted']);
        // Ученик правит только своё содержимое и только пока случай не
        // принят: принятый разбор — это документ о допуске, и менять его
        // задним числом нельзя.
        allow update: if isAdmin()
                      || (isOwner(uid)
                          && resource.data.status != 'accepted'
                          && request.resource.data.status in ['draft', 'submitted']
                          && !request.resource.data.diff(resource.data).affectedKeys()
                               .hasAny(['verdict', 'reviewedAt', 'reviewedBy']));
        allow delete: if isAdmin()
                      || (isOwner(uid) && resource.data.status == 'draft');
      }

      // Уведомления ученику (запрос автора, 2026-07-25): сообщение от
      // наставника, открытие оплаты, выдача сертификата, доступ к RUKYA Pro.
      // Раньше про всё, кроме сообщений, ученик узнавал случайно — зашёл и
      // заметил, что кнопка появилась.
      //
      // Создаёт их ТОЛЬКО сервер: Cloud Functions работают через Admin SDK и
      // эти правила обходят. Клиентская запись запрещена полностью — иначе
      // ученик мог бы подделать себе уведомление «доступ открыт» и ввести
      // себя же в заблуждение, а при поддержке — и наставника.
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if false;
        // Ученик может только пометить прочитанным — ровно одно поле.
        allow update: if isAdmin()
                      || (isOwner(uid)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                          && request.resource.data.read == true);
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    // Лента достижений учеников (запрос автора «пусть будет автоматом»,
    // 2026-07-26). Записи создаёт ТОЛЬКО сервер (functions/index.js,
    // Admin SDK) на основании реального прогресса: сданный экзамен,
    // отмеченная практика, сертификат, доступ к RUKYA Pro.
    //
    // Почему клиенту запись запрещена полностью: иначе любой ученик мог бы
    // опубликовать в общей ленте что угодно от чужого имени — и о чужом
    // здоровье в том числе. Сервер пишет только то, что видит в прогрессе.
    //
    // Читают только вошедшие: лента — часть кабинета, а не публичная
    // страница. Имя в записи хранится одно (без фамилии) — этого хватает
    // для мотивации и не превращает ленту в справочник учеников.
    match /feed/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Привязка Telegram: tgUsers/{chatId} = { uid, state, linkedAt }.
    // Пишет и читает только бот через Admin SDK — правила его не касаются.
    // Клиенту закрыто полностью: в этой коллекции лежит соответствие
    // «телеграм-аккаунт → ученик», и её чтение раскрыло бы, кто есть кто.
    match /tgUsers/{chatId} {
      allow read, write: if false;
    }

    // Полный текст платных книг/модулей (docId = bookKey() из
    // pages/js/modules-data.js). Реальная защита пейвола вместо визуальной
    // (project.md §18/§22, задача "закрыть дыру с платным контентом",
    // 2026-07-20): до этого полный текст лежал открытым в content/*.md на
    // GitHub независимо от статуса оплаты. Пишет сюда только скрипт
    // scripts/seed-paid-content.mjs через Admin SDK от имени автора курса —
    // клиентской записи с этой коллекцией не предполагается вовсе.
    match /content/{docId} {
      // Архив — исключение из общего правила "оплатил → читает всё": даже
      // paid == true не даёт доступа к этому docId, только isAdmin().
      // fullAccess — доступ, выданный автором вручную (кнопка «Всё
      // открыто» в кабинете админа, 2026-07-27). Читает так же, как
      // оплативший: иначе «доступ ко всем модулям» означал бы
      // одиннадцать страниц с урезанными отрывками. Архив им тоже не
      // открывается — исключение выше действует для всех, кроме админа.
      allow read: if isAdmin()
                  || (!isArchiveDoc(docId) && isSignedIn()
                      && (get(/databases/$(database)/documents/students/$(request.auth.uid)).data.paid == true
                          || get(/databases/$(database)/documents/students/$(request.auth.uid)).data.fullAccess == true));
      allow write: if false;
    }
  }
}
