rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // Раздел "Архив" (content/_content_archive_index_md — bookKey() от
    // "/content/archive/index.md") разбирает материалы, исключённые из
    // сертифицируемой программы, с прямой критикой конкретных книг/методик.
    // Автор попросил "убери от всех кроме меня админа" (2026-07-21) — на
    // клиенте (pages/book.html) уже сделано, но реальная защита живёт
    // здесь: без этой правки любой ОПЛАТИВШИЙ курс ученик всё равно мог бы
    // прочитать полный текст прямым запросом к Firestore (SDK/консоль),
    // в обход JS-стены — то же рассуждение, что и у общего правила ниже
    // ("реальная защита пейвола вместо визуальной").
    function isArchiveDoc(docId) {
      return docId == '_content_archive_index_md';
    }

    match /admins/{uid} {
      // Список админов не создаётся через клиент — только вручную в консоли Firebase
      // (integration/README.md, шаг "Первый админ"), чтобы никто не мог сам себя
      // назначить админом через клиентский код.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    match /students/{uid} {
      allow create: if isOwner(uid);
      allow read: if isOwner(uid) || isAdmin();
      // Ученик правит свой профиль/прогресс, но не поле paid — это переключает
      // только админ вручную (project.md §18).
      allow update: if (isOwner(uid) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paid']))
                    || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isOwner(uid) || isAdmin();
        // from обязан совпадать с реальной ролью пишущего — иначе ученик
        // может подделать сообщение "от админа" в своей же переписке.
        allow create: if (isOwner(uid) && request.resource.data.from == 'student')
                      || (isAdmin() && request.resource.data.from == 'admin');

        // Ученик отмечает прочитанными сообщения наставника. Раньше здесь
        // стояло только `isAdmin()`, поэтому markThreadRead(uid, 'student')
        // молча падал на правилах: поле read у сообщений админа навсегда
        // оставалось false, и наставник никогда не видел вторую галочку
        // (аудит 2026-07-25). Разрешаем узко — ученик может изменить ровно
        // одно поле `read` и только с false на true, у чужих (админских)
        // сообщений. Ни текст, ни автора, ни дату он так не подменит.
        function onlyMarksRead() {
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                 && request.resource.data.read == true
                 && resource.data.from == 'admin';
        }
        // Правка/удаление своего сообщения (запрос автора, 2026-07-25).
        // Ученик распоряжается только тем, что написал сам; текст можно
        // менять, авторство/дату создания — нет.
        function editsOwnText() {
          return resource.data.from == 'student'
                 && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
                 && request.resource.data.from == resource.data.from
                 && request.resource.data.createdAt == resource.data.createdAt;
        }
        allow update: if isAdmin()
                      || (isOwner(uid) && (onlyMarksRead() || editsOwnText()));
        allow delete: if isAdmin()
                      || (isOwner(uid) && resource.data.from == 'student');
      }

      // Уведомления ученику (запрос автора, 2026-07-25): сообщение от
      // наставника, открытие оплаты, выдача сертификата, доступ к RUKYA Pro.
      // Раньше про всё, кроме сообщений, ученик узнавал случайно — зашёл и
      // заметил, что кнопка появилась.
      //
      // Создаёт их ТОЛЬКО сервер: Cloud Functions работают через Admin SDK и
      // эти правила обходят. Клиентская запись запрещена полностью — иначе
      // ученик мог бы подделать себе уведомление «доступ открыт» и ввести
      // себя же в заблуждение, а при поддержке — и наставника.
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if false;
        // Ученик может только пометить прочитанным — ровно одно поле.
        allow update: if isAdmin()
                      || (isOwner(uid)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
                          && request.resource.data.read == true);
        allow delete: if isAdmin() || isOwner(uid);
      }
    }

    // Полный текст платных книг/модулей (docId = bookKey() из
    // pages/js/modules-data.js). Реальная защита пейвола вместо визуальной
    // (project.md §18/§22, задача "закрыть дыру с платным контентом",
    // 2026-07-20): до этого полный текст лежал открытым в content/*.md на
    // GitHub независимо от статуса оплаты. Пишет сюда только скрипт
    // scripts/seed-paid-content.mjs через Admin SDK от имени автора курса —
    // клиентской записи с этой коллекцией не предполагается вовсе.
    // Лента достижений учеников (запрос автора «пусть будет автоматом»,
    // 2026-07-26). Записи создаёт ТОЛЬКО сервер (functions/index.js,
    // Admin SDK) на основании реального прогресса: сданный экзамен,
    // отмеченная практика, сертификат, доступ к RUKYA Pro.
    //
    // Почему клиенту запись запрещена полностью: иначе любой ученик мог бы
    // опубликовать в общей ленте что угодно от чужого имени — и о чужом
    // здоровье в том числе. Сервер пишет только то, что видит в прогрессе.
    //
    // Читают только вошедшие: лента — часть кабинета, а не публичная
    // страница. Имя в записи хранится одно (без фамилии) — этого хватает
    // для мотивации и не превращает ленту в справочник учеников.
    match /feed/{entryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /content/{docId} {
      // Архив — исключение из общего правила "оплатил → читает всё": даже
      // paid == true не даёт доступа к этому docId, только isAdmin().
      allow read: if isAdmin()
                  || (!isArchiveDoc(docId) && isSignedIn()
                      && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.paid == true);
      allow write: if false;
    }
  }
}
