# Образец — скопируйте в functions/.env.local и заполните.
#
# ИМЕННО .env.local, А НЕ .env. Содержимое functions/.env Firebase
# выкладывает вместе с функциями как обычные переменные окружения, и они
# сталкиваются с секретами тех же имён — Cloud Run отвечает «Secret
# environment variable overlaps non secret environment variable» и отказ.
# Файлы с суффиксом .local используются только локальным эмулятором.
#
# ЭТОТ ФАЙЛ (.env.example) В РЕПОЗИТОРИИ, САМ .env.local — НЕТ.
# Он закрыт в .gitignore, и так должно остаться: токен бота даёт
# полный доступ к переписке с учениками и право писать от имени школы.
# Один раз токен уже утёк — он был вписан прямо в functions/index.js и
# читался по raw-ссылке GitHub (обнаружено 2026-07-25).
#
# .env.local нужен ТОЛЬКО для локального запуска эмулятора. В бою значения берутся
# из секретов Firebase и в файлах не хранятся вовсе:
#   firebase functions:secrets:set TG_BOT_TOKEN
#   firebase functions:secrets:set TG_CHAT_ID
#   firebase functions:secrets:set TG_WEBHOOK_SECRET

# Токен учебного бота @ruyka_school_bot — выдаёт @BotFather.
TG_BOT_TOKEN=

# Ваш личный chat_id: сюда приходят уведомления о новых учениках, оплатах и
# вопросы от учеников. Узнать можно у @userinfobot.
TG_CHAT_ID=

# Произвольная случайная строка (32+ символа). Тем же значением задаётся
# вебхук, и по нему функция отличает запросы Telegram от чужих:
#   https://api.telegram.org/bot<ТОКЕН>/setWebhook?url=<АДРЕС>&secret_token=<СЕКРЕТ>
TG_WEBHOOK_SECRET=

# Адрес сайта. Нужен боту, чтобы забирать тексты уроков и экзаменов.
# Менять только при переезде на свой домен.
SITE_URL=https://kingboob8880-pixel.github.io/raqiy-school
